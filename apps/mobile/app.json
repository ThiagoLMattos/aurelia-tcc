{
  "expo": {
    "name": "Aurelia",
    "slug": "Aurelia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aurelia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.aurelia.tcc",
      "supportsTablet": true
    },
    "android": {
      "package": "app.aurelia.tcc",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "O Aurélia mostra os contatos do celular na tela Telefone, para ligar com um toque. Nada é alterado nem enviado."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0F8080"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Aurélia usa a sua localização atual só para marcar o centro da zona segura."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Aurélia usa o microfone só enquanto você segura o botão para falar com a assistente.",
          "speechRecognitionPermission": "O Aurélia transforma o que você fala em texto para a assistente responder.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.tts"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
