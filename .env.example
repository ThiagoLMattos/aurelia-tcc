# ---- API (apps/api) ----
PORT=3000
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-web-api-key
USE_EMULATORS=false
LOG_LEVEL=info
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=your-groq-model-id
CORS_ORIGINS=http://localhost:8081
JOBS_TOKEN=generate-a-long-random-string
SCHEDULER_ENABLED=true
# Number of reverse proxies in front of the API (Cloud Run: 1). Leave 0 when running locally.
TRUST_PROXY=0

# ---- Mobile (apps/mobile) ----
# Expo reads these from apps/mobile/.env, not from a .env at the repository root.
# EXPO_PUBLIC_API_MODE=mock runs the app on an in-memory backend, with no API or Firebase.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api/v1
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
# Android builds only (Expo Go has its own): Google Maps SDK for Android key, restricted to the app.
# Read at build time by app.config.ts, so on EAS it is an environment variable, not EXPO_PUBLIC_.
GOOGLE_MAPS_API_KEY=your-google-maps-android-key
